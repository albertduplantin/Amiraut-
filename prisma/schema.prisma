// Amirauté en ligne — schéma V1 (mouvement + détection, sans combat)
// Voir C:\Users\topinambour\.claude\plans\robust-mapping-summit.md pour le contexte complet.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Scénario / équipes / flottes ──────────────────────────

model Scenario {
  id                 String         @id @default(cuid())
  name               String
  description        String?
  mapCenterLat       Float
  mapCenterLng       Float
  mapDefaultZoom     Float          @default(5)
  defaultTurnMinutes Int
  status             ScenarioStatus @default(DRAFT)
  createdAt          DateTime       @default(now())
  // Horodatage de fin de partie (voir Scenario.status = COMPLETED, gameEnd.ts,
  // action "Mettre fin à la partie" côté arbitre) — sert de date de clôture
  // affichée sur le compte rendu de fin d'opération (/report).
  endedAt            DateTime?

  teams        Team[]
  units        Unit[]
  turns        Turn[]
  participants Participant[]

  tacticalEngagements TacticalEngagement[]
}

enum ScenarioStatus {
  DRAFT
  ACTIVE
  COMPLETED
}

// ── Bibliothèque de scénarios créés par les joueurs ───────────
//
// À ne pas confondre avec `Scenario` ci-dessus (une partie en cours,
// instanciée). `CustomScenario` stocke un GABARIT réutilisable, au même
// format que les scénarios intégrés (`ScenarioDefinition`, voir
// prisma/scenarios/types.ts) — même pipeline `instantiateScenario` pour les
// deux, voir prisma/scenarios/index.ts.

model CustomScenario {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String
  // ScenarioDefinition complet (équipes, flottes, unités, météo,
  // objectifs...) validé par zod à l'écriture ET à la lecture — voir
  // prisma/scenarios/validation.ts.
  definition  Json
  createdAt   DateTime @default(now())
}

model Team {
  id         String   @id @default(cuid())
  scenarioId String
  scenario   Scenario @relation(fields: [scenarioId], references: [id])
  name       String
  colorHex   String   @default("#3388ff")

  fleets       Fleet[]
  participants Participant[]
  reports      Report[]
  signals      Signal[]

  tacticalParticipants TacticalParticipant[]

  @@unique([scenarioId, name])
}

model Fleet {
  id     String @id @default(cuid())
  teamId String
  team   Team   @relation(fields: [teamId], references: [id])
  name   String

  units              Unit[]
  pendingTransfersIn Unit[]                  @relation("PendingFleetTransfer")
  scopedTokens       ParticipantFleetScope[]
}

// ── Bibliothèque d'unités (gabarits réutilisables) ────────

model UnitClass {
  id                    String       @id @default(cuid())
  name                  String
  nation                String
  category              UnitCategory
  maxSpeedKnots         Float
  lengthMeters          Float? // longueur hors-tout réelle, pour l'échelle des silhouettes vue de dessus
  beamMeters            Float? // largeur hors-tout réelle, pour la taille de cible au combat (L × l)
  sensors               Json // [{ type: "RADAR", rangeNm: 20 }, ...]
  detectability         Float        @default(1)
  iconKey               String
  profileImageUrl       String? // silhouette de profil (vue latérale)
  planImageUrl          String? // silhouette vue de dessus, si disponible
  historicalNote        String? // contexte historique du type de navire
  // Installation immobile (ex: station d'écoute côtière) plutôt qu'un
  // navire : ne peut réalistiquement pas se déplacer, l'UI le signale aux
  // joueurs (badge/tooltip) plutôt que de les laisser deviner pourquoi elle
  // ne bouge jamais — voir Signal/HF_DF et prisma/scenarios/north-cape.ts.
  passive               Boolean      @default(false)
  enduranceMinutes      Int? // réservé phase 2 (autonomie/carburant), inutilisé en V1
  weaponSystems         Json? // fiche d'armement historique affichée aux joueurs (texte libre)
  combatProfile         Json? // armement structuré utilisé par le moteur de combat, voir CombatProfile dans combat.ts
  depthChargeStock      Int? // stock initial de grenades ASM (escorteurs uniquement), voir Unit.depthChargesRemaining
  // Mortier ASM Hedgehog (escorteurs équipés seulement, à partir de 1942) :
  // tire vers l'avant sans jamais rompre le contact ASDIC actif, contrairement
  // aux grenades ASM classiques qui obligent à passer au-dessus de la cible et
  // à interrompre l'écoute le temps de la passe — voir Unit.sonarBlindNextRound
  // et resolveHedgehogAttack dans combat.ts (recherche 2026-08-14, règles
  // avancées de François Marlière). Stock compté en salves (une salve = une
  // gerbe de 24 projectiles), pas en projectiles unitaires.
  hedgehogStock         Int?
  // Autonomie sous-marine (sous-marins uniquement) : batterie ~80nm à 4nds
  // pour un Type VIIC (uboat.net), oxygène/CO2 jusqu'à ~72h en cas extrême
  // (cartouches + bouteilles de secours) — voir Unit.batteryChargePercent et
  // Unit.oxygenHoursRemaining.
  submergedRangeNmAt4kt Float?
  oxygenEnduranceHours  Float?
  torpedoStock          Int? // torpilles totales embarquées (sous-marins), voir Unit.torpedoesRemaining
  // Temps de plongée d'urgence (sous-marins uniquement), variable par marine
  // (recherche 2026-08-14) : ~30s U-Boote allemands, ~45s japonais/américains,
  // ~60s britanniques/italiens. Réduit d'autant le budget de route disponible
  // la manche où le sous-marin plonge depuis la surface — voir
  // submitTacticalMovementForUnit dans tacticalEngine.ts.
  emergencyDiveSeconds  Float?

  // Manœuvre (mode tactique) : diamètre tactique / vitesse maximale de
  // rotation issus de recherches historiques (voir prisma/seed.ts et
  // prisma/scenarios/denmark-strait.ts pour le détail par classe et les
  // sources). Nullables pour rester compatibles avec d'anciennes classes
  // non encore renseignées — le moteur applique alors un repli par
  // catégorie plutôt que de planter.
  turningRadiusM         Float?
  accelerationKnotsPerMin Float?

  // Combat air-air (avions uniquement) : maniabilité relative au combat
  // tournoyant, distincte de turningRadiusM (rayon de virage en vol de
  // transit, en mètres — sans rapport avec l'agilité en dogfight). 0-1,
  // calibrée sur des cas documentés (chasseur monoplace moderne ~0.8-0.95,
  // hydravion/bombardier lourd ~0.1-0.3) — voir combat.ts, airCombatHitChancePercent.
  agility Float?
  // Niveau de l'équipage (avions uniquement), A (élite) à F (très mauvais) —
  // Amirauté 2013 de F. Marlière §4.1.1.2 : la supériorité japonaise de 1942
  // doit autant à l'excellence des pilotes qu'aux qualités du Zéro, les
  // déboires italiens tiennent à leurs tactiques plus qu'à l'obsolescence de
  // leurs appareils. Multiplie la précision en bombardement/mitraillage et
  // en combat air-air (voir combat.ts, pilotSkillMultiplier) — C (moyen) par
  // défaut si non renseigné, comportement inchangé pour les classes existantes.
  pilotSkill String?

  units Unit[]
}

enum UnitCategory {
  SURFACE_SHIP
  SUBMARINE
  AIRCRAFT
}

// ── Bibliothèque de classes partagée (navires + avions) ────────
//
// Distincte d'UnitClass : UnitClass est une copie jetable créée à chaque
// instanciation de partie (voir instantiateScenario) — modifier une classe
// en cours de partie ne doit jamais affecter les autres parties. Celle-ci
// est LA source éditable par l'arbitre via /library, dans laquelle un
// scénario peut piocher par sa clé plutôt que de tout redéfinir en ligne
// (voir prisma/scenarios/types.ts, ScenarioUnitClass.libraryKey). Mêmes
// champs qu'UnitClass, à quelques ajouts près (key, theater).
model LibraryUnitClass {
  id                    String       @id @default(cuid())
  // Slug stable, référencé depuis le JSON d'un scénario (libraryKey) —
  // jamais réutilisé pour une autre classe, même après renommage de `name`.
  key                   String       @unique
  name                  String
  nation                String
  category              UnitCategory
  maxSpeedKnots         Float
  lengthMeters          Float?
  beamMeters            Float?
  sensors               Json
  detectability         Float   @default(1)
  iconKey               String
  profileImageUrl       String?
  planImageUrl          String?
  historicalNote        String?
  passive               Boolean @default(false)
  enduranceMinutes      Int?
  weaponSystems         Json?
  combatProfile         Json?
  depthChargeStock      Int?
  hedgehogStock         Int? // voir le commentaire équivalent sur UnitClass
  submergedRangeNmAt4kt Float?
  oxygenEnduranceHours  Float?
  torpedoStock          Int?
  emergencyDiveSeconds  Float? // voir le commentaire équivalent sur UnitClass
  turningRadiusM         Float?
  accelerationKnotsPerMin Float?
  agility                Float?
  pilotSkill              String? // voir le commentaire équivalent sur UnitClass
  resistancePoints        Float // voir UnitClass.healthMax/Current, calculé à l'instanciation à partir de cette valeur
  // Repère libre pour le classement dans /library (ex. "Atlantique/Arctique
  // 1939-45") — pas utilisé par le moteur, juste pour s'y retrouver.
  theater                 String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Instances d'unités dans un scénario ───────────────────

model Unit {
  id                    String     @id @default(cuid())
  scenarioId            String
  scenario              Scenario   @relation(fields: [scenarioId], references: [id])
  fleetId               String
  fleet                 Fleet      @relation(fields: [fleetId], references: [id])
  // Transfert de flotte demandé par un joueur (ordre par signal) : prend
  // effet à la publication du tour en cours, pas immédiatement — le navire
  // a besoin d'un tour pour rallier sa nouvelle formation.
  pendingFleetId        String?
  pendingFleet          Fleet?     @relation("PendingFleetTransfer", fields: [pendingFleetId], references: [id])
  unitClassId           String
  unitClass             UnitClass  @relation(fields: [unitClassId], references: [id])
  name                  String
  pennant               String?
  historicalNote        String? // contexte historique propre à ce navire (rôle dans la bataille, etc.)
  status                UnitStatus @default(ACTIVE)
  healthMax             Float? // potentiel de résistance initial (formule du livret : Dw/1000 + blindage + K%)
  healthCurrent         Float?
  currentLat            Float
  currentLng            Float
  currentHeadingDeg     Float?
  lastResolvedTurn      Int        @default(0)
  // Palier d'immersion courant (sous-marins uniquement ; toujours SURFACE
  // pour les autres catégories). Changé par ordre, un seul palier adjacent
  // à la fois — voir UnitOrder.depthBand et resolveTurnDetections/resolveCombat.
  depthBand             DepthBand  @default(SURFACE)
  depthChargesRemaining Int? // grenades ASM restantes (escorteurs uniquement, null sinon)
  hedgehogRoundsRemaining Int? // salves de Hedgehog restantes (escorteurs équipés uniquement, null sinon)
  // Contact ASDIC actif rompu par la dernière attaque aux grenades ASM (voir
  // combat.ts/tacticalEngine.ts) : la manche suivante, ce navire n'entend
  // plus au SONAR (seulement HYDROPHONE/RADAR/VISUEL) le temps de reprendre
  // l'écoute — consommé puis remis à false dans recomputeContacts. Un tir de
  // Hedgehog ne pose jamais ce drapeau : c'est tout l'intérêt de l'arme.
  sonarBlindNextRound   Boolean   @default(false)
  // Autonomie sous-marine courante (sous-marins uniquement, null sinon) : la
  // batterie se vide en immersion (vite à haute vitesse, cf. combat.ts),
  // l'oxygène se consomme au temps passé immergé quelle que soit la vitesse.
  // Les deux se rechargent/renouvellent intégralement en faisant surface.
  batteryChargePercent  Float?
  oxygenHoursRemaining  Float?
  torpedoesRemaining    Int? // torpilles restantes (sous-marins), tous types confondus

  // ── Dégâts localisés (mode tactique, bâtiments de surface) ──────────
  // Au-delà de la simple perte de PV, un coup au but "solide" peut
  // handicaper durablement un système précis — cas historiques qui
  // inspirent le modèle (voir combat.ts, rollLocalizedDamage) : le
  // gouvernail du Bismarck bloqué par une torpille aérienne (24 mai 1941),
  // la salle des chaudières du Scharnhorst touchée au cap Nord faisant
  // chuter sa vitesse de 30 à ~22 nds (13 déc. 1943), la tourelle avant du
  // Bismarck détruite tôt dans son dernier combat, le magasin du Hood qui
  // a explosé. Dégâts permanents pour la durée de l'engagement (pas de
  // réparation en cours de combat) — voir tacticalEngine.ts.
  disabledWeaponSlots   String[]  @default([]) // pièces détruites (ex: "gun:1", "torpedo") — voir TacticalAction.weaponSlot
  speedCapKnots         Float? // vitesse max réduite par une avarie de machines (null = pas de plafond, utilise UnitClass.maxSpeedKnots)
  rudderJammed          Boolean   @default(false) // gouvernail bloqué : ne peut plus manœuvrer, cap maintenu
  fireControlDamaged    Boolean   @default(false) // télépointage endommagé : pénalité de précision sur ses propres tirs

  // ── Ordres permanents (bloc 3) ──────────────────────────────────────
  // Un ordre marqué permanent est reconduit automatiquement par le moteur
  // chaque tour (même cap et vitesse pour un TRANSIT, cycle décollage →
  // recherche → retour pour un AIR_PATROL) sans que le joueur ait à le
  // ressaisir — voir turnEngine.ts, applyStandingOrders. Il s'interrompt
  // (standingOrderActive repasse à false) dès qu'une détection impliquant
  // l'unité est confirmée par l'arbitre à la publication, ou sur annulation
  // du joueur, ou — sous-marin immergé — si l'autonomie ne suit plus (renvoi
  // automatique en surface).
  standingOrderActive  Boolean            @default(false)
  standingOrderKind    StandingOrderKind?
  standingSpeedKnots   Float?
  // Base aérienne d'affectation (avions uniquement) — distincte de la
  // position courante : un terrain fixe (ex. RAF Sullom Voe), pas
  // l'endroit où l'avion se trouve au moment où l'ordre de patrouille est
  // donné (qui peut être un point de transit ad hoc). saveAirPatrolOrder
  // s'en sert pour airHomeLat/Lng, avec repli sur la position courante si
  // absente (compatible avec les scénarios existants, non renseignés).
  // Nullable pour toute unité non aérienne.
  baseLat              Float?
  baseLng              Float?
  baseName             String?
  // Patrouille aérienne (avions uniquement) : décollage depuis airHome →
  // recherche en boucle autour de airPatrol → retour se poser à airHome dès
  // que le carburant restant ne permet plus qu'un aller simple, puis nouveau
  // décollage si l'ordre permanent est toujours actif.
  airMissionState      AirMissionState?
  airHomeLat           Float?
  airHomeLng           Float?
  airPatrolLat         Float?
  airPatrolLng         Float?
  fuelMinutesRemaining Float?

  orders           UnitOrder[]
  detectedAs       DetectionEvent[] @relation("TargetUnit")
  observedFrom     DetectionEvent[] @relation("ObserverUnit")
  combatAsTarget   CombatEvent[]    @relation("CombatTarget")
  combatAsAttacker CombatEvent[]    @relation("CombatAttacker")
  signalsSent      Signal[]

  tacticalParticipations TacticalParticipant[]
  tacticalActions        TacticalAction[]
  tacticalTargetedBy     TacticalAction[]      @relation("TacticalTarget")
  tacticalContactedAs    TacticalContact[]     @relation("TacticalContactTarget")
  torpedoSalvosFired     TacticalTorpedoSalvo[] @relation("TorpedoSalvoFirer")
  torpedoSalvosTargeted  TacticalTorpedoSalvo[] @relation("TorpedoSalvoTarget")
  torpedoSalvosHitBy     TacticalTorpedoSalvo[] @relation("TorpedoSalvoHit")
  standingRoutes         StandingRoute[]

  @@index([scenarioId, fleetId])
}

enum UnitStatus {
  ACTIVE
  DAMAGED
  SUNK
  WITHDRAWN
}

// Immersion faible ≤30m / moyenne 31-80m / grande >80m (livret original) :
// SHALLOW permet encore le tir de torpilles, MEDIUM/DEEP non ; seul HYDROPHONE/
// SONAR peut détecter un sous-marin hors SURFACE (voir weather.ts/turnEngine.ts).
enum DepthBand {
  SURFACE
  SHALLOW
  MEDIUM
  DEEP
}

// Bloc 3 — ordres longue durée : voir Unit.standingOrderActive.
enum StandingOrderKind {
  TRANSIT // maintien du cap et de la vitesse du dernier ordre
  AIR_PATROL // décollage → recherche → retour, en boucle (avions) — avec ou sans rotation de zones, voir StandingRoute
  // Trajectoire longue durée dessinée à l'avance (navires de surface), vitesse
  // par segment — voir StandingRoute/RouteWaypoint et applyRouteTransitLeg
  // dans turnEngine.ts. Recherche 2026-08-14 (refonte ordres permanents).
  ROUTE
}

enum AirMissionState {
  OUTBOUND // en transit vers la zone de recherche
  SEARCHING // en boucle sur la zone de recherche
  RETURNING // en transit retour vers la base
}

// ── Accès (pas de comptes — token d'invitation opaque) ────

model Participant {
  id                   String          @id @default(cuid())
  scenarioId           String
  scenario             Scenario        @relation(fields: [scenarioId], references: [id])
  token                String          @unique @default(cuid())
  role                 ParticipantRole
  teamId               String?
  team                 Team?           @relation(fields: [teamId], references: [id])
  scopeAllFleetsInTeam Boolean         @default(true)
  displayName          String
  // Code couleur d'affichage quand plusieurs joueurs se partagent une même
  // équipe (bloc 2) : permet aux coéquipiers/à l'arbitre de distinguer qui
  // commande quoi (ex. pastille de couleur à côté du nom de flotte). Sans
  // objet pour un participant seul sur son équipe (reste null).
  colorHex             String?
  lastSeenAt           DateTime?
  createdAt            DateTime        @default(now())

  fleetScopes     ParticipantFleetScope[]
  ordersSubmitted UnitOrder[]

  @@index([scenarioId])
}

enum ParticipantRole {
  ARBITER
  PLAYER
}

model ParticipantFleetScope {
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id])
  fleetId       String
  fleet         Fleet       @relation(fields: [fleetId], references: [id])

  @@id([participantId, fleetId])
}

// ── Tours / météo ──────────────────────────────────────────

model Turn {
  id              String     @id @default(cuid())
  scenarioId      String
  scenario        Scenario   @relation(fields: [scenarioId], references: [id])
  number          Int
  status          TurnStatus @default(PENDING_ORDERS)
  gameStartAt     DateTime
  durationMinutes Int
  // Tour resserré parce qu'un contact est engagé : la durée passe à
  // TACTICAL_TURN_MINUTES pour que les manœuvres et tirs se jouent à une
  // échelle de temps de combat plutôt que de transit (voir turnEngine.ts).
  tacticalMode    Boolean    @default(false)
  weatherId       String?    @unique
  weather         Weather?   @relation(fields: [weatherId], references: [id])
  resolvedAt      DateTime?
  publishedAt     DateTime?
  // Horodatage réel (pas le temps fictif gameStartAt) de création de ce
  // tour — utile pour tout diagnostic/tri par récence, notamment sur le
  // cron d'avancement automatique (voir autoAdvanceScenario, turnEngine.ts).
  createdAt       DateTime   @default(now())

  orders          UnitOrder[]
  detectionEvents DetectionEvent[]
  combatEvents    CombatEvent[]
  reports         Report[]
  signals         Signal[]

  tacticalEngagements TacticalEngagement[]

  @@unique([scenarioId, number])
}

enum TurnStatus {
  PENDING_ORDERS
  RESOLVING
  PENDING_ARBITER_REVIEW
  PUBLISHED
}

model Weather {
  id            String        @id @default(cuid())
  visibilityNm  Float
  seaState      Int
  daylight      Daylight
  precipitation Precipitation @default(NONE)
  windKnots     Float?
  notes         String?

  turn Turn?
}

enum Daylight {
  DAY
  TWILIGHT
  NIGHT
  POLAR_NIGHT
  POLAR_DAY
}

enum Precipitation {
  NONE
  RAIN
  SNOW
  FOG
}

// ── Ordres / trajets ────────────────────────────────────────

model UnitOrder {
  id            String       @id @default(cuid())
  turnId        String
  turn          Turn         @relation(fields: [turnId], references: [id])
  unitId        String
  unit          Unit         @relation(fields: [unitId], references: [id])
  // Nul quand l'ordre est reconduit automatiquement par un ordre permanent
  // (voir Unit.standingOrderActive) plutôt que saisi par un joueur ce tour-ci.
  submittedById String?
  submittedBy   Participant? @relation(fields: [submittedById], references: [id])
  speedKnots    Float
  // Palier d'immersion demandé pour ce tour (sous-marins uniquement) ; null =
  // pas de changement, l'unité garde son Unit.depthBand actuel. Doit être
  // adjacent au palier courant (un seul changement de palier par tour).
  depthBand     DepthBand?
  // Généré par le moteur (ordre permanent reconduit ou patrouille aérienne)
  // plutôt que dessiné par le joueur ce tour-ci — affiché différemment côté UI.
  isStanding    Boolean      @default(false)
  submittedAt   DateTime     @default(now())

  waypoints Waypoint[]

  @@unique([turnId, unitId])
}

model Waypoint {
  id       String    @id @default(cuid())
  orderId  String
  order    UnitOrder @relation(fields: [orderId], references: [id])
  sequence Int
  lat      Float
  lng      Float

  @@unique([orderId, sequence])
}

// ── Trajectoire longue durée (bloc 3, refonte) ───────────────
//
// Un ordre permanent ROUTE (navire) ou une rotation de patrouilles
// AIR_PATROL (avion) dessinée à l'avance sur plusieurs manches — voir
// Unit.standingOrderKind, applyRouteTransitLeg/applyAirPatrolLeg dans
// turnEngine.ts. Un seul modèle pour les deux usages plutôt que d'en
// dupliquer un par catégorie d'unité : seuls les champs pertinents de
// RouteWaypoint sont renseignés selon `kind`.

model StandingRoute {
  id     String @id @default(cuid())
  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id])
  // ROUTE (navire, trajet de transit) ou AIR_PATROL (avion, rotation de
  // zones de recherche) — jamais TRANSIT simple, qui n'a pas besoin de ce
  // modèle. Voir StandingOrderKind.
  kind   StandingOrderKind
  status RouteStatus       @default(ACTIVE)
  // Index (dans `waypoints`, triés par `sequence`) du prochain point pas
  // encore atteint. Pas besoin de stocker une position de curseur séparée :
  // Unit.currentLat/Lng fait déjà foi pour la position exacte le long de la
  // route, y compris en cours de segment.
  cursorSequence Int      @default(0)
  createdAt      DateTime @default(now())

  waypoints RouteWaypoint[]
}

model RouteWaypoint {
  id      String        @id @default(cuid())
  routeId String
  route   StandingRoute @relation(fields: [routeId], references: [id])
  sequence Int
  lat     Float
  lng     Float
  // ROUTE : vitesse jusqu'à ce point (nds). AIR_PATROL : non renseigné.
  speedKnots   Float?
  // AIR_PATROL : nombre de cycles décollage → recherche → retour à
  // effectuer sur cette zone avant de passer à la suivante de la liste.
  // ROUTE : non renseigné.
  patrolCycles Int?

  @@unique([routeId, sequence])
}

enum RouteStatus {
  ACTIVE
  COMPLETED // trajet/rotation entièrement parcouru(e)
  CANCELLED // annulé par le joueur, ou interrompu par une détection confirmée (ROUTE seulement — voir publishTurn)
}

// ── Détection / revue arbitre ───────────────────────────────

model DetectionEvent {
  id                       String        @id @default(cuid())
  turnId                   String
  turn                     Turn          @relation(fields: [turnId], references: [id])
  observerUnitId           String
  observerUnit             Unit          @relation("ObserverUnit", fields: [observerUnitId], references: [id])
  targetUnitId             String
  targetUnit               Unit          @relation("TargetUnit", fields: [targetUnitId], references: [id])
  method                   SensorType
  cpaDistanceNm            Float
  cpaMinutesIntoTurn       Float
  observerLatAtCpa         Float
  observerLngAtCpa         Float
  targetLatAtCpa           Float
  targetLngAtCpa           Float
  systemProposed           Boolean       @default(true)
  arbiterStatus            ArbiterStatus @default(PROPOSED)
  arbiterNote              String?
  decidedById              String?

  combatEvents CombatEvent[]

  @@unique([turnId, observerUnitId, targetUnitId])
}

enum SensorType {
  RADAR
  VISUAL
  HYDROPHONE
  SONAR
  // Goniométrie HF ("Huff-Duff") : relèvement radio, pas un capteur physique
  // classique — voir Signal et resolveTurnDetections. Uniquement déclenché
  // par une émission HF adverse (HF_LONG/HF_KURZSIGNAL), jamais par le
  // déplacement d'une unité comme les autres capteurs.
  HF_DF
  OTHER
}

enum ArbiterStatus {
  PROPOSED
  CONFIRMED
  REJECTED
  ADDED_MANUALLY
}

// ── Combat ──────────────────────────────────────────────────
// Déclenché pour toute détection CONFIRMÉE/ADDED_MANUALLY dont la distance
// de CPA tombe dans la portée d'une arme de l'observateur : l'engagement
// suit directement la confirmation de détection par l'arbitre (arbitrage
// hybride, cohérent avec la détection). Voir src/lib/combat.ts.

model CombatEvent {
  id               String          @id @default(cuid())
  turnId           String
  turn             Turn            @relation(fields: [turnId], references: [id])
  // Détection à l'origine de l'engagement : sert de garde-fou pour qu'un
  // tir déclenché manuellement en mode tactique ne soit pas ensuite résolu
  // une seconde fois par la passe automatique de fin de tour (et
  // inversement), voir resolveCombat()/fireTacticalWeapon() dans turnEngine.ts.
  detectionEventId String?
  detectionEvent   DetectionEvent? @relation(fields: [detectionEventId], references: [id])
  attackerUnitId   String
  attackerUnit     Unit            @relation("CombatAttacker", fields: [attackerUnitId], references: [id])
  targetUnitId     String
  targetUnit       Unit            @relation("CombatTarget", fields: [targetUnitId], references: [id])
  weaponType       WeaponType
  // Identifiant du type de torpille utilisé (ex: "g7a"/"g7e"), null pour
  // canon/grenades ASM ou torpille sans variantes — voir CombatProfile.torpedoTypes.
  torpedoTypeId    String?
  rangeNm          Float
  hitChancePercent Float
  hits             Int
  damagePoints     Float
  targetHealthLeft Float
  targetSunk       Boolean         @default(false)
  firedTactically  Boolean         @default(false)
  createdAt        DateTime        @default(now())

  @@index([turnId])
  @@index([detectionEventId, weaponType])
}

enum WeaponType {
  GUN
  TORPEDO
  DEPTH_CHARGE
  // Bombe d'avion (bombardement en piqué ou horizontal) — voir CombatProfile.bombs
  // dans combat.ts. Une torpille aérienne reste WeaponType.TORPEDO : mêmes
  // règles physiques qu'une torpille de surface une fois à l'eau.
  BOMB
  // Mortier ASM Hedgehog : tire vers l'avant sans rompre le contact ASDIC —
  // voir Unit.sonarBlindNextRound et resolveHedgehogAttack dans combat.ts.
  HEDGEHOG
}

// ── Rapport publié, filtré par équipe ────────────────────────

model Report {
  id          String   @id @default(cuid())
  turnId      String
  turn        Turn     @relation(fields: [turnId], references: [id])
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id])
  publishedAt DateTime @default(now())
  ownUnits    Json
  contacts    Json
  combats     Json? // engagements d'artillerie impliquant l'équipe ce tour (voir CombatEvent)
  narrative   String?

  @@unique([turnId, teamId])
}

// ── Communications (bloc 4) ───────────────────────────────────
//
// Quatre canaux, quatre compromis portée/discrétion (voir la recherche
// historique dans la mémoire du projet) : le visuel et la TBS sont sûrs
// mais courte portée, le W-T HF porte à l'infini mais expose à la
// goniométrie adverse (voir resolveTurnDetections, méthode HF_DF) — le
// Kurzsignal réduit ce risque en réduisant le temps d'antenne, au prix
// d'un contenu limité à des formes standard.

model Signal {
  id            String        @id @default(cuid())
  turnId        String
  turn          Turn          @relation(fields: [turnId], references: [id])
  teamId        String
  team          Team          @relation(fields: [teamId], references: [id])
  senderUnitId  String
  senderUnit    Unit          @relation(fields: [senderUnitId], references: [id])
  channel       SignalChannel
  // Forme standard du message si canal = HF_KURZSIGNAL (CONTACT / POSITION /
  // MÉTÉO) — null pour les trois autres canaux, en texte libre.
  kurzsignalType String?
  body          String
  // Vrai dès qu'au moins une détection HF_DF a été calculée à partir de ce
  // message (voir resolveTurnDetections) — feedback pour le joueur sur la
  // discipline radio, indépendant de la confirmation arbitre de cette
  // détection.
  intercepted   Boolean       @default(false)
  createdAt     DateTime      @default(now())

  @@index([turnId, teamId])
}

enum SignalChannel {
  VISUAL // lampe Aldis, pavillons, sémaphore : vue directe, quelques nm, aucune émission radio.
  TBS // Talk Between Ships (VHF voix) : ~25nm, portée optique, quasi indétectable au-delà de l'horizon.
  HF_LONG // message long en Morse, portée illimitée, forte exposition à la goniométrie.
  HF_KURZSIGNAL // code comprimé (~20s d'antenne), portée illimitée, exposition réduite — formes standard uniquement.
}

// ── Bataille tactique ────────────────────────────────────────
//
// Quand un contact devient un vrai duel, on quitte l'échelle du transit
// (des heures) pour celle du combat : des manches courtes (5 min par
// défaut) enchaînant deux phases, comme dans le livret original.
//
//   MOUVEMENT : les deux camps manœuvrent, puis le moteur recalcule qui
//               voit qui — un sous-marin jusque-là invisible peut se
//               faire repérer ici.
//   TIR       : chaque camp tire, mais uniquement sur ce qu'il a détecté.
//               Ouvrir le feu trahit sa propre position (feu de bouche,
//               sillage de torpille) pour la manche suivante.
//
// On répète jusqu'à destruction d'un camp, épuisement des munitions ou
// rupture de contact.

model TacticalEngagement {
  id            String             @id @default(cuid())
  scenarioId    String
  scenario      Scenario           @relation(fields: [scenarioId], references: [id])
  turnId        String
  turn          Turn               @relation(fields: [turnId], references: [id])
  status        TacticalStatus     @default(AWAITING_MOVEMENT)
  syncMode      TacticalSyncMode   @default(ASYNC)
  roundNumber   Int                @default(1)
  /// Durée d'une manche en minutes (le livret résout le combat par tranches de 5 min).
  roundMinutes  Int                @default(5)
  endReason     TacticalEndReason?
  /// L'arbitre a suspendu le combat : plus aucune soumission acceptée tant qu'il n'a pas relancé.
  arbiterPaused Boolean            @default(false)
  startedAt     DateTime           @default(now())
  endedAt       DateTime?

  participants TacticalParticipant[]
  actions      TacticalAction[]
  contacts     TacticalContact[]
  submissions  TacticalSubmission[]
  messages     TacticalMessage[]
  torpedoSalvos TacticalTorpedoSalvo[]

  @@index([scenarioId, status])
}

enum TacticalStatus {
  AWAITING_MOVEMENT
  AWAITING_FIRE
  RESOLVED
}

enum TacticalSyncMode {
  /// Les deux camps sont présents : la manche s'enchaîne dès que tout le monde a validé.
  SYNC
  /// Chacun joue quand il veut, la manche se résout dès la dernière soumission.
  ASYNC
}

enum TacticalEndReason {
  ALL_ENEMIES_SUNK
  CONTACT_LOST
  OUT_OF_AMMUNITION
  ARBITER_ENDED
  DISENGAGED
}

model TacticalParticipant {
  engagementId String
  engagement   TacticalEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  unitId       String
  unit         Unit               @relation(fields: [unitId], references: [id])
  teamId       String
  team         Team               @relation(fields: [teamId], references: [id])
  joinedRound  Int                @default(1)

  @@id([engagementId, unitId])
  @@index([engagementId, teamId])
}

/// Ordre d'une unité pour une phase d'une manche : manœuvre ou tir selon `phase`.
model TacticalAction {
  id           String             @id @default(cuid())
  engagementId String
  engagement   TacticalEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  roundNumber  Int
  phase        TacticalPhase
  unitId       String
  unit         Unit               @relation(fields: [unitId], references: [id])
  teamId       String

  // Phase MOUVEMENT
  headingDeg   Float? // cap final, dérivé du dernier segment de movementPath au moment de la résolution
  speedKnots   Float?
  /// Tracé complet choisi par le joueur pour cette manche (clic à clic sur
  /// la carte, comme en mode stratégique) : [{lat,lng}, ...], budgété par
  /// speedKnots × durée de la manche. Absent = l'unité reste sur place.
  movementPath Json?
  depthBand    DepthBand?

  // Phase TIR
  targetUnitId  String?
  targetUnit    Unit?       @relation("TacticalTarget", fields: [targetUnitId], references: [id])
  weaponType    WeaponType?
  torpedoTypeId String?
  /// Identifie QUELLE pièce a tiré ("gun:0", "gun:1", "torpedo"...) — un
  /// navire peut tirer avec chacune de ses pièces la même manche (une seule
  /// fois par pièce). Vide ("") pour les actions de la phase MOUVEMENT, qui
  /// restent une seule ligne par navire et par manche.
  weaponSlot    String      @default("")

  // Résultat, calculé immédiatement à la validation du tir (pas d'attente de
  // l'autre camp) : le joueur voit le compte rendu tout de suite.
  resolved         Boolean  @default(false)
  hit              Boolean?
  hits             Int?
  damagePoints     Float?
  /// Estimation provisoire (ce tir seul suffit-il à couler la cible ?), affichée
  /// immédiatement ; peut être corrigée à la baisse si la cible encaisse aussi
  /// d'autres tirs simultanés — voir `applied`.
  targetSunk       Boolean?
  hitChancePercent Float?
  /// Tirage au sort (0-100) comparé à `hitChancePercent` pour décider du
  /// coup : en-dessous = touché. Affiché aux joueurs pour rendre le
  /// mécanisme transparent (pas juste un résultat, le jet lui-même).
  hitRoll          Float?
  /// Effet localisé proposé par ce coup (tourelle détruite, salle des
  /// machines touchée, gouvernail bloqué, télépointage endommagé, magasin
  /// atteint), appliqué en bloc à `resolveFirePhase` comme `damagePoints` —
  /// voir combat.ts (rollLocalizedDamage) et Unit (disabledWeaponSlots &c).
  /// Absent = ce coup n'a rien handicapé au-delà de sa perte de PV.
  localizedEffect  Json?
  /// Récit du coup, affiché aux joueurs.
  narrative        String?
  /// Détail des calculs (précision + tirage de localisation), à des fins de
  /// débogage/transparence — voir describeHitChanceDebug/describeLocalizedRollDebug
  /// dans tacticalNarrative.ts. Pas une règle du livret original, juste notre formule.
  debugInfo        String?
  /// Le tir a trahi la position du tireur (feu de bouche, sillage) pour la manche suivante.
  revealedShooter  Boolean  @default(false)
  /// Les dégâts de ce tir ont été portés au potentiel de la cible : se fait en
  /// bloc, avec tous les tirs de la manche, une fois les deux camps prêts à
  /// passer à la manche suivante — pour que les tirs restent simultanés (on ne
  /// sait pas encore, en tirant, si la cible a déjà été touchée ailleurs).
  applied          Boolean  @default(false)

  createdAt DateTime @default(now())

  @@unique([engagementId, roundNumber, phase, unitId, weaponSlot])
  @@index([engagementId, roundNumber])
}

enum TacticalPhase {
  MOVEMENT
  FIRE
}

/// Qui voit quoi à l'issue de la phase de mouvement d'une manche.
model TacticalContact {
  id             String             @id @default(cuid())
  engagementId   String
  engagement     TacticalEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  roundNumber    Int
  observerTeamId String
  observerUnitId String
  targetUnitId   String
  targetUnit     Unit               @relation("TacticalContactTarget", fields: [targetUnitId], references: [id])
  method         SensorType
  distanceNm     Float
  /// Position réelle de la cible au moment du relevé — pas transmise telle
  /// quelle au joueur (qui ne voit que distance/relèvement reconstruit) :
  /// sert à replacer le marqueur sur la carte et à estimer un vecteur de
  /// déplacement d'une manche à l'autre (voir page.tsx, estimatedVectorByTarget).
  targetLatSnapshot Float?
  targetLngSnapshot Float?

  @@unique([engagementId, roundNumber, observerUnitId, targetUnitId])
  @@index([engagementId, roundNumber, observerTeamId])
}

/// Validation d'une phase par un camp : la manche se résout quand les deux ont validé.
model TacticalSubmission {
  engagementId String
  engagement   TacticalEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  roundNumber  Int
  phase        TacticalPhase
  teamId       String
  submittedAt  DateTime           @default(now())

  @@id([engagementId, roundNumber, phase, teamId])
}

/// Messagerie du combat : dialogue entre joueurs, interventions et événements de l'arbitre.
model TacticalMessage {
  id           String              @id @default(cuid())
  engagementId String
  engagement   TacticalEngagement  @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  kind         TacticalMessageKind @default(CHAT)
  /// null = visible par tous les camps ; sinon réservé à cette équipe.
  teamId       String?
  authorName   String
  body         String
  roundNumber  Int
  createdAt    DateTime            @default(now())

  @@index([engagementId, createdAt])
}

enum TacticalMessageKind {
  /// Message entre joueurs.
  CHAT
  /// Événement injecté par l'arbitre (avarie, renfort, ordre du commandement…).
  ARBITER_EVENT
  /// Message narratif produit par le moteur.
  SYSTEM
}

// ── Salve de torpilles en transit (navires/sous-marins) ────────────
//
// Recherche 2026-08-14 (règles originales Paul Bois §"dynamique du jeu" +
// Amirauté 2013 de Francis Marlière §2.2) : contrairement à l'artillerie,
// une torpille n'atteint pas sa cible instantanément — sa vitesse est trop
// faible relativement à la distance de tir (souvent 5-10 minutes de trajet
// et plus). Le tireur choisit donc un CAP (pas juste "je vise ce navire")
// et une largeur de salve, la torpille avance ensuite manche après manche
// pendant la RÉSOLUTION DU MOUVEMENT (pas du tir) jusqu'à interception,
// portée max dépassée, ou fin de l'engagement — la cible peut donc esquiver
// en changeant de cap après le lancement, ce qu'un tir de canon ne permet
// jamais. Ne concerne QUE les torpilles de navires/sous-marins : une
// torpille aérienne, larguée à très courte distance (quelques centaines de
// mètres), reste résolue instantanément via TacticalAction/WeaponType.TORPEDO
// classique — sa distance de largage est déjà négligeable devant la durée
// d'une manche tactique. Voir torpedoSalvo.ts.
model TacticalTorpedoSalvo {
  id               String              @id @default(cuid())
  engagementId     String
  engagement       TacticalEngagement  @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  firedRoundNumber Int
  firedByUnitId    String
  firedByUnit      Unit                @relation("TorpedoSalvoFirer", fields: [firedByUnitId], references: [id])
  firedByTeamId    String
  /// Cible visée à l'origine — indicatif seulement (aide à l'affichage/à la narration), l'interception réelle est purement géométrique et ne dépend pas de ce champ.
  targetUnitId     String?
  targetUnit       Unit?               @relation("TorpedoSalvoTarget", fields: [targetUnitId], references: [id])
  torpedoTypeId    String?
  /// Nombre de torpilles de la salve — détermine la largeur de la zone de danger (voir torpedoSalvo.ts) et est déduit du stock du tireur au lancement.
  torpedoCount     Int
  spread           TorpedoSpread       @default(STANDARD)
  headingDeg       Float
  speedKnots       Float
  maxRangeM        Float
  /// Fiabilité (0-1) figée au lancement — voir DEFAULT_TORPEDO_RELIABILITY dans combat.ts.
  reliability      Float               @default(0.75)
  /// Position courante de la salve (avance chaque manche tant que IN_TRANSIT) — pas la position du tireur, qui a pu bouger depuis.
  currentLat       Float
  currentLng       Float
  distanceTraveledM Float              @default(0)
  status           TorpedoSalvoStatus  @default(IN_TRANSIT)
  hitUnitId        String?
  hitUnit          Unit?               @relation("TorpedoSalvoHit", fields: [hitUnitId], references: [id])
  resolvedRoundNumber Int?
  createdAt        DateTime            @default(now())

  @@index([engagementId, status])
}

enum TorpedoSpread {
  /// 100 yards + 1% de la distance parcourue × n torpilles (Amirauté 2013, §2.2.2.3).
  NARROW
  /// 100 yards + 2% × distance × n.
  STANDARD
  /// 100 yards + 4% × distance × n — croise plus facilement la route de la cible, mais dilue les chances qu'un coup porte.
  WIDE
}

enum TorpedoSalvoStatus {
  IN_TRANSIT
  HIT
  /// Portée maximale dépassée sans interception — la salve a coulé sans avoir croisé la route d'une cible.
  MISSED
}
